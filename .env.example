# ============================================================================
# 1. NVIDIA NIM API CONFIGURATION (Required)
# Supports comma-separated keys for automatic rotation + 38 RPM rate-limiting
# ============================================================================
NVIDIA_API_KEYS="nvapi-your-first-key-here,nvapi-your-optional-second-key"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# Recommended tool-calling models on NVIDIA NIM:
# - qwen/qwen3-235b-a22b
# - stepfun-ai/step-5-preview
# - nvidia/llama-3.3-nemotron-super-49b-v1
NVIDIA_MODEL="model/name-here"

# ============================================================================
# 2. WEB SEARCH CONFIGURATION (Optional - Auto-falls back to Zero-Key Scraper)
# If provided, uses Tavily API first; otherwise uses built-in DuckDuckGo +
# Mozilla Readability + Turndown Markdown extraction pipeline (0 keys needed).
# ============================================================================
TAVILY_API_KEY=""